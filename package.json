{
  "name": "supertool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "panda codegen && next dev",
    "prebuild": "panda codegen --clean",
    "build": "next build",
    "postinstall": "panda codegen",
    "start": "next start",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "panda codegen && husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "vitest --browser",
    "mcp:validate": "node scripts/validate-mcp.js",
    "mcp:setup": "node scripts/validate-mcp.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@ark-ui/react": "^5.26.2",
    "@codemirror/lang-json": "^6.0.2",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.76.1",
    "@uiw/react-codemirror": "^4.25.2",
    "browser-image-compression": "^2.0.2",
    "framer-motion": "^12.23.24",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.547.0",
    "nanoid": "^5.1.6",
    "next": "16.0.0",
    "nuqs": "^2.7.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "@pandacss/dev": "^1.4.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.2.6",
    "playwright": "^1.49.1",
    "postcss": "^8.5.6",
    "typescript": "^5",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "webdriverio": "^9.4.2"
  }
}
