    "format:check": "biome format .",
    "prepare": "panda codegen && husky",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "vitest --browser",
    "mcp:validate": "node scripts/validate-mcp.js",
    "mcp:setup": "node scripts/validate-mcp.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
