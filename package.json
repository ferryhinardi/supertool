    "dev": "panda codegen && next dev",
    "prebuild": "panda codegen --clean",
    "build": "next build",
    "postinstall": "panda codegen",
    "start": "next start",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:eslint": "eslint .",
