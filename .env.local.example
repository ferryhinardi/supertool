# Base URL for the application (used for SEO, OG images, sitemap, etc.)
# Development: http://localhost:3000
# Production: https://supertool.dev (or your actual domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_COPILOT_DEFAULT_REPO=ferryhinardi/supertool
ANALYZE=false

# Supabase Configuration
# Get your credentials from: https://app.supabase.com → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# GitHub MCP
GITHUB_TOKEN=your_github_personal_access_token

# AI Tools
OPENAI_API_KEY=

# Feedback Form
WEB3FORMS_ACCESS_KEY=

EXCHANGE_RATE_API_KEY=

# ScreenshotOne API Key: https://screenshotone.com/
SCREENSHOTONE_ACCESS_KEY=

# Ads / affiliates
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ENABLE_ADSENSE=false
NEXT_PUBLIC_ENABLE_CARBON_ADS=false
NEXT_PUBLIC_ENABLE_ETHICAL_ADS=false
NEXT_PUBLIC_ENABLE_AFFILIATES=false
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=
NEXT_PUBLIC_CARBON_SERVE_ID=
NEXT_PUBLIC_CARBON_PLACEMENT=
NEXT_PUBLIC_ETHICAL_ADS_PUBLISHER_ID=
NEXT_PUBLIC_AFFILIATE_1PASSWORD_REF=
NEXT_PUBLIC_AFFILIATE_BITWARDEN_REF=
NEXT_PUBLIC_AFFILIATE_DASHLANE_REF=
NEXT_PUBLIC_AFFILIATE_CLOUDINARY_REF=
NEXT_PUBLIC_AFFILIATE_TINYPNG_REF=
NEXT_PUBLIC_AFFILIATE_POSTMAN_REF=
NEXT_PUBLIC_AFFILIATE_INSOMNIA_REF=
NEXT_PUBLIC_AFFILIATE_NORDVPN_REF=
NEXT_PUBLIC_AFFILIATE_EXPRESSVPN_REF=
NEXT_PUBLIC_AFFILIATE_VERCEL_REF=
NEXT_PUBLIC_AFFILIATE_CLOUDFLARE_REF=
NEXT_PUBLIC_AFFILIATE_SUPABASE_REF=

# Polar
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
NEXT_PUBLIC_POLAR_DONATION_PRODUCT_ID=

# Resend Email API
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
