# Base URL for the application (used for SEO, OG images, sitemap, etc.)
# Development: http://localhost:3000
# Production: https://supertool.dev (or your actual domain)
NEXT_PUBLIC_BASE_URL=https://supertool.dev

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Analytics 4
# Get your Measurement ID from: https://analytics.google.com/analytics/web/
# Navigate to: Admin → Data Streams → Web → Copy Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# MCP Configuration
# Required for GitHub MCP server
GITHUB_TOKEN=your_github_personal_access_token

# Optional MCP Servers
# Uncomment and set if you want to enable these servers

# Brave Search (for web search capabilities)
# BRAVE_API_KEY=your_brave_api_key

# Slack Integration
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_TEAM_ID=your-team-id

# Database (if using PostgreSQL MCP server)
# DATABASE_URL=postgresql://user:password@localhost:5432/supertool

# ========================================
# AI TOOLS CONFIGURATION
# ========================================
# OpenAI API Key (required for AI-powered tools)
# Get your API key from: https://platform.openai.com/api-keys
# Used by: AI Snippet Generator, AI Image Caption
OPENAI_API_KEY=

# Anthropic API Key (optional for future AI tools)
# ANTHROPIC_API_KEY=your_anthropic_key

# Exchange Rate API Key
# Get your API key from: https://app.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# ScreenshotOne API Key
# Get your API key from: https://screenshotone.com/
# Used by: Website Screenshot Tool
SCREENSHOTONE_ACCESS_KEY=

# ========================================
# ADS CONFIGURATION
# ========================================
# Master switch - Enable/disable all ads
NEXT_PUBLIC_ENABLE_ADS=false

# Individual Ad Network Controls
# Enable specific ad networks (only works if NEXT_PUBLIC_ENABLE_ADS=true)
NEXT_PUBLIC_ENABLE_ADSENSE=false
NEXT_PUBLIC_ENABLE_CARBON_ADS=false
NEXT_PUBLIC_ENABLE_ETHICAL_ADS=false
NEXT_PUBLIC_ENABLE_AFFILIATES=false

# Ad Network Credentials
# Google AdSense
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=

# Carbon Ads (get yours at https://www.carbonads.net)
NEXT_PUBLIC_CARBON_SERVE_ID=
NEXT_PUBLIC_CARBON_PLACEMENT=

# EthicalAds (get yours at https://www.ethicalads.io)
NEXT_PUBLIC_ETHICAL_ADS_PUBLISHER_ID=

# Affiliate Partner IDs
# Password Manager Affiliates
NEXT_PUBLIC_AFFILIATE_1PASSWORD_REF=
NEXT_PUBLIC_AFFILIATE_BITWARDEN_REF=
NEXT_PUBLIC_AFFILIATE_DASHLANE_REF=

# Image/CDN Service Affiliates
NEXT_PUBLIC_AFFILIATE_CLOUDINARY_REF=
NEXT_PUBLIC_AFFILIATE_TINYPNG_REF=

# API/Developer Tool Affiliates
NEXT_PUBLIC_AFFILIATE_POSTMAN_REF=
NEXT_PUBLIC_AFFILIATE_INSOMNIA_REF=

# VPN Service Affiliates
NEXT_PUBLIC_AFFILIATE_NORDVPN_REF=
NEXT_PUBLIC_AFFILIATE_EXPRESSVPN_REF=

# Hosting/Cloud Service Affiliates
NEXT_PUBLIC_AFFILIATE_VERCEL_REF=
NEXT_PUBLIC_AFFILIATE_CLOUDFLARE_REF=
NEXT_PUBLIC_AFFILIATE_SUPABASE_REF=

# ========================================
# PAYMENT & SUBSCRIPTIONS (POLAR)
# ========================================
# Polar Configuration
# Get your credentials from: https://polar.sh/dashboard/settings
# Access Token: API Keys → Create Access Token
# Webhook Secret: Webhooks → Create Endpoint → Copy Secret
# Organization ID: Settings → Organization → Copy ID

# Polar Access Token (required for server-side API calls)
POLAR_ACCESS_TOKEN=

# Polar Webhook Secret (required to verify webhook signatures)
POLAR_WEBHOOK_SECRET=

# Polar Organization ID (your Polar organization identifier)
POLAR_ORGANIZATION_ID=

# Product ID for donation checkout (create product in Polar dashboard)
NEXT_PUBLIC_POLAR_DONATION_PRODUCT_ID=