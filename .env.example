# Base URL for the application (used for SEO, OG images, sitemap, etc.)
# Development: http://localhost:3000
# Production: https://supertool.dev (or your actual domain)
NEXT_PUBLIC_BASE_URL=https://supertool.dev

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Analytics 4
# Get your Measurement ID from: https://analytics.google.com/analytics/web/
# Navigate to: Admin → Data Streams → Web → Copy Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# MCP Configuration
# Required for GitHub MCP server
GITHUB_TOKEN=your_github_personal_access_token

# Optional MCP Servers
# Uncomment and set if you want to enable these servers

# Brave Search (for web search capabilities)
# BRAVE_API_KEY=your_brave_api_key

# Slack Integration
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# SLACK_TEAM_ID=your-team-id

# Database (if using PostgreSQL MCP server)
# DATABASE_URL=postgresql://user:password@localhost:5432/supertool

# Other API Keys (add as needed)
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# Exchange Rate API Key
# Get your API key from: https://app.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=